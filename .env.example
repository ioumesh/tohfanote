# Vercel: set these four variables for Production AND any Preview deployment
# you want to test. Do not prefix secrets with NEXT_PUBLIC_. Redeploy afterward.
R2_ENDPOINT=https://YOUR_32_CHARACTER_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET_NAME=tohfanote-gifts
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Local only: put this in .env.local to use private data/ files without R2.
# GIFT_STORAGE=local
# DATA_DIR=./data
# A complete R2 configuration automatically selects R2 on your local machine.
# Vercel always requires R2 and refuses local storage, preventing data loss.

# Privacy upgrade: generate two DIFFERENT random secrets (at least 32 characters).
# Required on Vercel; do not use these example comments as actual values.
SESSION_SECRET=
CRON_SECRET=
# Local filesystem mode creates a private persistent local session secret itself.
